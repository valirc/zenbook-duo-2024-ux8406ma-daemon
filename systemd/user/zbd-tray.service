# zbd-tray.service — user-session tray and event monitor.
#
# This is a user unit (loaded by `systemctl --user`) that runs in
# the user's graphical session. It owns:
#   - the GLib tray icon (custom org.kde.StatusNotifierItem in
#     src/tray_sni.c + libdbusmenu-glib for the context menu — no
#     GTK, no libayatana-appindicator),
#   - the Bluetooth connection monitor (bluetoothctl --monitor),
#   - the udev USB monitor on the configured port path,
#   - the udev DRM hotplug monitor (rebuilds the "Monitor principal"
#     submenu when externals come and go),
#   - the iio-sensor-proxy orientation monitor,
#   - the wallpaper and display reconfiguration calls (gsettings +
#     gdctl/xrandr talking to the compositor over the session D-Bus),
#   - the dash-to-panel always-visible policy and primary-monitor
#     mirror (src/dash_to_panel.c — see /etc/zbd/zbd.conf
#     `dash_to_panel_gestionar` to opt out).
#
# It does NOT need root: brightness/battery/DMIC happen in the
# system service zbd-system.service via D-Bus + polkit.

[Unit]
Description=zbd-tray: Zenbook Duo session monitors and tray icon
Documentation=https://github.com/valirc/zenbook-duo-2024-ux8406ma-daemon
After=graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zbd-tray
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# Hardening for the user binary. It calls into:
#   - GIO/GLib for D-Bus (StatusNotifierItem + dbusmenu, libgio for
#     dash-to-panel/hidetopbar gsettings) — pure GLib, no GTK/X11,
#   - libusb (keyboard backlight via D-Bus to zbd-system, or directly
#     when running as root for debugging),
#   - libudev netlink monitor (USB + DRM hotplug),
#   - subprocesses: bluetoothctl, gsettings, gdctl/xrandr, pactl.
#
# We restrict only what the user binary genuinely does not need;
# the UI stack and gsettings backends read many directories so
# ProtectSystem must stay at `false` (otherwise theme/icon/cursor
# and dconf lookups fail).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @swap @reboot @raw-io

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zbd-tray

[Install]
WantedBy=graphical-session.target
