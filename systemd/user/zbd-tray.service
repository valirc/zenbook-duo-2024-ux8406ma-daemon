# zbd-tray.service — user-session tray and event monitor.
#
# This is a user unit (loaded by `systemctl --user`) that runs in
# the user's graphical session. It owns:
#   - the GLib tray icon (libayatana-appindicator-glib, no GTK),
#   - the Bluetooth connection monitor (bluetoothctl --monitor),
#   - the udev USB monitor on the configured port path,
#   - the iio-sensor-proxy orientation monitor,
#   - the wallpaper and display reconfiguration calls (gsettings +
#     gdctl/xrandr talking to the compositor over the session D-Bus).
#
# It does NOT need root: brightness/battery/DMIC happen in the
# system service zbd-system.service via D-Bus + polkit.

[Unit]
Description=zbd-tray: Zenbook Duo session monitors and tray icon
Documentation=https://github.com/valirc/zenbook-duo-2024-ux8406ma-daemon
After=graphical-session.target
PartOf=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/zbd-tray
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# Hardening for the user binary. It calls into:
#   - libayatana-appindicator-glib (pure GLib, no GTK/X11),
#   - libusb (keyboard backlight via D-Bus to zbd-system, or directly
#     when running as root for debugging),
#   - libudev netlink monitor,
#   - subprocesses: bluetoothctl, gsettings, gdctl/xrandr, pactl.
#
# We restrict only what the user binary genuinely does not need;
# the UI stack reads many directories so ProtectSystem must stay at
# `false` (otherwise GTK theme/icon/cursor lookups fail).
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @swap @reboot @raw-io

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zbd-tray

[Install]
WantedBy=graphical-session.target
