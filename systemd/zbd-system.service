# zbd-system.service — long-running D-Bus service.
#
# zbd-system runs as the privileged half of zbd. It owns the
# org.anexa.zbd1 bus name on the system bus and exposes the
# org.anexa.zbd1.System interface (see dbus/org.anexa.zbd.conf and
# polkit/org.anexa.zbd.policy). The user-session service zbd-tray
# routes its privileged operations (set screen/keyboard backlight,
# battery threshold, configure DMIC) through that interface so the
# user-facing GUI never has to hold root privileges.
#
# As soon as zbd-system starts it applies the persistent defaults
# from /etc/zbd/zbd.conf (battery threshold, brightness, keyboard
# backlight) so the same unit replaces the previous oneshot. Then it
# enters the sd-bus event loop and stays there until SIGTERM.

[Unit]
Description=zbd-system: Zenbook Duo privileged D-Bus service
Documentation=https://github.com/valirc/zenbook-duo-2024-ux8406ma-daemon
After=multi-user.target sound.target dbus.service
Wants=sound.target
Requires=dbus.service

[Service]
Type=dbus
BusName=org.anexa.zbd1
ExecStart=/usr/local/sbin/zbd-system service
Restart=on-failure
RestartSec=3s

# === Hardening =============================================================
# zbd-system writes a tiny set of paths and runs a tiny set of
# external programs (pactl). Lock everything else down.

# CAP_SYS_ADMIN is required by libusb_detach_kernel_driver() during
# keyboard backlight changes. Drop everything else. AmbientCaps means
# the binary itself can use them without setuid.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

# Filesystem
ProtectSystem=strict
ReadWritePaths=/sys/class/backlight /sys/class/power_supply
ProtectHome=yes
PrivateTmp=yes
# libusb necesita /dev/bus/usb para detach_kernel_driver y SET_REPORT.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/bus/usb rw

# Kernel & process
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
NoNewPrivileges=yes

# Network: solo D-Bus (UNIX domain socket).
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX

# Syscall surface
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @reboot @raw-io

# Memory
MemoryDenyWriteExecute=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zbd-system

[Install]
WantedBy=multi-user.target
