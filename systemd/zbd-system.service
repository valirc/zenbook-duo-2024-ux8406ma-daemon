# zbd-system.service — long-running D-Bus service.
#
# zbd-system runs as the privileged half of zbd. It owns the
# org.anexa.zbd1 bus name on the system bus and exposes the
# org.anexa.zbd1.System interface (see dbus/org.anexa.zbd.conf and
# polkit/org.anexa.zbd.policy). The user-session service zbd-tray
# routes its privileged operations (set screen/keyboard backlight,
# battery threshold, configure DMIC) through that interface so the
# user-facing GUI never has to hold root privileges.
#
# As soon as zbd-system starts it applies the persistent defaults
# from /etc/zbd/zbd.conf (battery threshold, brightness, keyboard
# backlight) so the same unit replaces the previous oneshot. Then it
# enters the sd-bus event loop and stays there until SIGTERM.

[Unit]
Description=zbd-system: Zenbook Duo privileged D-Bus service
Documentation=https://github.com/valirc/zenbook-duo-2024-ux8406ma-daemon
After=multi-user.target sound.target dbus.service
Wants=sound.target
Requires=dbus.service

[Service]
Type=dbus
BusName=org.anexa.zbd1
ExecStart=/usr/local/sbin/zbd-system service
Restart=on-failure
RestartSec=3s
# pactl (used for DMIC setup) needs XDG_RUNTIME_DIR to locate the
# PipeWire socket at /run/user/0/pulse/native. PULSE_RUNTIME_PATH
# stops libpulse from trying to create ~/.config/pulse (read-only
# under ProtectSystem=strict).
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PULSE_RUNTIME_PATH=/run/user/0/pulse

# === Hardening =============================================================
# zbd-system writes a tiny set of paths and runs a tiny set of
# external programs (pactl). Lock everything else down.

# CAP_SYS_ADMIN is required by libusb_detach_kernel_driver() during
# keyboard backlight changes. Drop everything else. AmbientCaps means
# the binary itself can use them without setuid.
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN

# Filesystem
ProtectSystem=strict
ReadWritePaths=/sys/class/backlight /sys/class/power_supply
# Bind the user runtime directory into the service's private mount
# namespace so that pactl can reach the PipeWire socket when
# ConfigureDmic is invoked via D-Bus after the user session is up.
# The directory may not exist at service start (user not logged in
# yet); BindPaths= handles missing sources gracefully.
BindPaths=/run/user/0
ProtectHome=yes
PrivateTmp=yes
# libusb enumera y abre dispositivos USB a traves de /dev/bus/usb/<bus>/<dev>.
# Estas son device nodes con majors variables, asi que en lugar de listar
# nodes especificos (DeviceAllow espera nodos de tipo `char-major:minor`,
# no directorios) dejamos a la cgroup-device del cgroup v2 hacer su trabajo:
#   - PrivateDevices=no        - el daemon ve los devices reales,
#   - DevicePolicy=auto        - permite los devices que el cgroup permita
#                                normalmente; sigue siendo mas restrictivo
#                                que `strict` y mucho mas que `private`.
PrivateDevices=no
DevicePolicy=auto

# Kernel & process
# ProtectKernelTunables=yes monta /sys read-only globalmente y, en
# kernels actuales, ReadWritePaths bajo /sys no consigue revertir
# eso para los archivos individuales de /sys/class/backlight y
# /sys/class/power_supply que el daemon necesita escribir. Por eso
# se deja en `no`; los demas Protect*  siguen activos para el resto
# del kernel surface (modules, logs, control groups, ...).
ProtectKernelTunables=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
NoNewPrivileges=yes

# Network y address families.
# - PrivateNetwork=yes: el daemon nunca habla TCP/IP.
# - AF_UNIX:    requerido para D-Bus (socket Unix del system bus).
# - AF_NETLINK: requerido por libusb (lee /sys via netlink uevent
#               para enumerar dispositivos USB).
# - IPAddressDeny=any: refuerzo de PrivateNetwork ante kernel sin
#   namespaces, no añade superficie.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# Syscall surface
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @debug @mount @swap @reboot @raw-io

# Memory
MemoryDenyWriteExecute=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zbd-system

[Install]
WantedBy=multi-user.target
