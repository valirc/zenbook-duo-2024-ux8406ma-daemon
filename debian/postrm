#!/bin/sh
# postrm — clean up after uninstall.

set -e

case "$1" in
    purge)
        # Drop the configuration we shipped if the admin has not
        # already removed it. Keep user-modified files unless the
        # admin explicitly purges.
        rm -f /etc/zbd/zbd.conf
        rmdir /etc/zbd 2>/dev/null || true
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
    ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
    ;;
    *)
        echo "postrm called with unknown argument: $1" >&2
        exit 1
    ;;
esac

#DEBHELPER#
exit 0
